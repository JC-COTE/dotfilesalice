/* Rofi theme matching Waybar: black bg, purple accent, bottom border, rounded */

* {
    bg:        #000000;
    fg:        #8b0ab3;
    accent:    #8b0ab3;
    selected:  #45475a66;   /* Waybar active workspace colour, see-through */
    muted:     #6c757d;

    font:             "JetBrainsMono Nerd Font, Maple Mono NF 11";
    background-color: transparent;
    text-color:       @fg;
    margin:           0;
    padding:          0;
    spacing:          0;
}

window {
    location:         center;
    anchor:           center;
    width:            600px;
    background-color: @bg;
    border:           0px 0px 3px 0px;   /* bottom border only, like the bar */
    border-color:     @accent;
    border-radius:    16px;
    padding:          12px;
}

mainbox {
    spacing:  10px;
    children: [ inputbar, listview ];
}

inputbar {
    padding:       8px 12px;
    spacing:       10px;
    border:        0px 0px 2px 0px;
    border-color:  @accent;
    border-radius: 16px;
    children:      [ prompt, entry ];
}

prompt {
    text-color: @accent;
}

entry {
    placeholder:       "Search...";
    placeholder-color: @muted;
    cursor:            text;
}

listview {
    lines:        8;
    columns:      1;
    fixed-height: true;
    scrollbar:    false;
    spacing:      4px;
}

element {
    padding:       6px 12px;
    spacing:       10px;
    border-radius: 16px;
    cursor:        pointer;
}

element selected.normal,
element selected.active {
    background-color: @selected;
}

element-icon {
    size:   20px;
    cursor: inherit;
}

element-text {
    text-color:     inherit;
    vertical-align: 0.5;
    cursor:         inherit;
}

message {
    padding: 6px 12px;
}

textbox {
    text-color: @muted;
}
